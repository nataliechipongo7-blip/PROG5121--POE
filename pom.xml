name: Java Maven CI

on:
  push:
    branches:
      - main
      - khanban
      - "khanban/**"
      - "khanban-*"
  pull_request:
    branches:
      - main
      - khanban
      - "khanban/**"
      - "khanban-*"

jobs:
  test:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v5
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: 'maven'

      - name: Run Maven Tests
        run: mvn -B test --file pom.xm
